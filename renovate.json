{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "schedule:weekly"],
  "timezone": "Europe/Paris",
  "labels": ["Infra"],
  "automerge": false,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "commitMessagePrefix": "⬆️(repo):",
  "packageRules": [
    {
      "description": "One weekly PR for every minor and patch update: the pnpm catalog and pnpm itself. Majors keep one PR each.",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "groupSlug": "minor-patch"
    },
    {
      "description": "Node.js: .nvmrc and every engines field move to the next LTS major in one PR",
      "matchDepNames": ["node"],
      "groupName": "Node.js",
      "rangeStrategy": "replace"
    },
    {
      "description": "@types/node follows the Node.js major of .nvmrc: approve it from the Dependency Dashboard along with the Node.js upgrade",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ]
}
